{#- 文章元信息里追加：正文字数、预计阅读时间（不含代码块，按每分钟 400 字估算），首页卡片上再显示标签 #}
{%- set prose = post.content | replace(r/<figure class="highlight[\s\S]*?<\/figure>/g, '') | striptags | replace(r/\s+/g, '') %}
{%- set words = prose | length %}
{%- set minutes = ((words / 400) | round(0, 'ceil')) or 1 %}
<span class="post-meta-item" title="正文字数（不含代码）">
  <span class="post-meta-item-icon"><i class="far fa-file-lines"></i></span>
  <span>{{ words }} 字</span>
</span>
<span class="post-meta-item" title="预计阅读时间">
  <span class="post-meta-item-icon"><i class="far fa-clock"></i></span>
  <span>约 {{ minutes }} 分钟</span>
</span>
{%- if is_index and post.tags and post.tags.length %}
<span class="post-meta-item post-meta-tags">
  {%- for tag in post.tags.toArray() %}
    <a href="{{ url_for(tag.path) }}" rel="tag">#{{ tag.name }}</a>
  {%- endfor %}
</span>
{%- endif %}
