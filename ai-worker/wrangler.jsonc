{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qdy-private-blog-ai",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "vars": {
    "SITE_ORIGIN": "https://qdy1013.github.io",
    "DEEPSEEK_MODEL": "deepseek-flash"
  },
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "73641001", "simple": { "limit": 10, "period": 60 } },
    { "name": "CHAT_LIMIT", "namespace_id": "73641002", "simple": { "limit": 10, "period": 60 } }
  ]
}
